AGAPAY_ENVIRONMENT=development
AGAPAY_DATABASE_URL=sqlite:///./agapay_dev.db
AGAPAY_SESSION_DAYS=7
AGAPAY_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# Sample forecast responses are also restricted to the development environment.
AGAPAY_PREDICTION_PREVIEW_ENABLED=true
# Dashboard controlled-basin adapter; additionally restricted to development.
AGAPAY_HYBRID_PROJECTION_ENABLED=true
AGAPAY_HYBRID_MODEL_DIRECTORY=../data/models/hybrid_rain_v01_20261012T003510Z_fdaff56583ad
AGAPAY_HYBRID_DATASET_PATH=../data/processed/urdaneta_example_20261011T231532Z_ed4c1003e2e4.csv
# First-administrator browser registration also requires development and localhost.
AGAPAY_LOCAL_ADMIN_SETUP_ENABLED=true
# R4: only field_reviewed station configurations may drive resident push, the staff
# operational queue or citywide dispatch. Measurements and incidents are always kept.
# Default-deny. "false" is ignored in production and whenever a notification provider
# other than "disabled" is configured (fail closed: never reaches a real phone).
AGAPAY_OPERATIONAL_REVIEW_REQUIRED=true
AGAPAY_TELEMETRY_STALE_AFTER_SECONDS=30
# Authenticated attempts per minute per station/channel, shared by HTTP and MQTT.
AGAPAY_TELEMETRY_INGEST_PER_MINUTE=120
AGAPAY_RAIN_INGEST_PER_MINUTE=240

# MQTT remains off for the first HTTP simulator test.
AGAPAY_MQTT_ENABLED=false
# Shared workflow read model; original observation timestamps are never renewed.
AGAPAY_READ_MODEL_CACHE_ENABLED=true
AGAPAY_READ_MODEL_WORKER_ENABLED=false
AGAPAY_READ_MODEL_SECONDS=2
AGAPAY_READ_MODEL_REFRESH_AHEAD=true
AGAPAY_READ_MODEL_STALE_SECONDS=2
AGAPAY_READ_MODEL_WAIT_SECONDS=2
# Per-process PostgreSQL pool; budget across all processes in docs/database-capacity.md.
# Left unset on purpose: API processes then use 5/10 and background workers 2/1. Setting these in a
# shared environment file would give every worker process the API pool and break the budget.
# AGAPAY_DATABASE_POOL_SIZE=5
# AGAPAY_DATABASE_MAX_OVERFLOW=10
AGAPAY_DATABASE_POOL_TIMEOUT_SECONDS=10
AGAPAY_OPERATIONS_REQUIRED=["monitoring"]
AGAPAY_OPERATIONS_PROBE_ENABLED=false
AGAPAY_OBSERVABILITY_ENABLED=true
# Optional private monitoring scraper token, >=32 random characters when configured.
AGAPAY_OBSERVABILITY_SCRAPE_TOKEN=
AGAPAY_MQTT_HOST=localhost
AGAPAY_MQTT_PORT=1883
AGAPAY_MQTT_TLS=false
AGAPAY_MQTT_USERNAME=
AGAPAY_MQTT_PASSWORD=
AGAPAY_MQTT_CLIENT_ID=agapay-backend-dev
AGAPAY_MQTT_TOPIC=agapay/stations/+/telemetry

# Dedicated durable rain feed. User confirmed STATION_001 calibration: 0.70 mm/tip.
AGAPAY_RAIN_GAUGE_ENABLED=false
AGAPAY_RAIN_GAUGE_TOPIC=agapay/stations/+/rain
AGAPAY_RAIN_GAUGE_STORE_PATH=../data/live_rain/rain-events.sqlite3
AGAPAY_RAIN_GAUGE_CALIBRATIONS={"STATION_001":0.70}
AGAPAY_RAIN_GAUGE_ALLOW_SIMULATOR=false
AGAPAY_RAIN_RAW_RETENTION_DAYS=30
AGAPAY_RAIN_ARCHIVE_DIRECTORY=../data/rain-archives
AGAPAY_RAIN_ARCHIVE_BATCH=5000

# Optional FCM transport: see docs/firebase-fcm-setup.md. Never paste credentials here.
AGAPAY_NOTIFICATION_PROVIDER=disabled
AGAPAY_NOTIFICATION_TTL_SECONDS=300
AGAPAY_NOTIFICATION_RECEIPT_DAYS=7
# Restore witness for send-capable workers: a directory OUTSIDE the database and its backups.
# Required in production; see docs/delivery-recovery.md.
AGAPAY_DELIVERY_LEDGER_PATH=
AGAPAY_FIREBASE_PROJECT_ID=
AGAPAY_FIREBASE_CREDENTIALS_PATH=

# Account recovery, invitations and staff MFA are explicit deployment capabilities.
AGAPAY_IDENTITY_MAIL_PROVIDER=disabled
AGAPAY_IDENTITY_ENCRYPTION_KEY=
AGAPAY_PUBLIC_WEB_ORIGIN=
AGAPAY_SMTP_HOST=
AGAPAY_SMTP_PORT=587
AGAPAY_SMTP_TLS_MODE=starttls
AGAPAY_SMTP_USERNAME=
AGAPAY_SMTP_PASSWORD=
AGAPAY_SMTP_SENDER=
AGAPAY_STAFF_MFA_REQUIRED=false
AGAPAY_AUTH_TRUSTED_PROXY_PEERS=[]
AGAPAY_AUTH_PROXY_KEY=
AGAPAY_SEED_DEMO_DATA=false
AGAPAY_DEPLOYMENT_CONFIRMED=false
# Production must use deploy/identity.production.env.example and app.serve_production.

# F27: public API HTTPS origin and optional private CA/mTLS files (never disable verification).
AGAPAY_PUBLIC_API_ORIGIN=
AGAPAY_MQTT_CA_FILE=
AGAPAY_MQTT_CLIENT_CERT_FILE=
AGAPAY_MQTT_CLIENT_KEY_FILE=

# F40: reviewed organizational/privacy ownership attestation; never auto-approved.
AGAPAY_SERVICE_GOVERNANCE_PATH=
# Supply backup keys only through protected secret injection, never this file.
# AGAPAY_BACKUP_KEY: base64-encoded 32-byte secret; independent from identity encryption.
# AGAPAY_RECOVERY_TEMP_DIRECTORY: reviewed private staging on encrypted storage.
