AGAPAY_ENVIRONMENT=development
AGAPAY_DATABASE_URL=sqlite:///./agapay_dev.db

# MQTT remains off for the first HTTP simulator test.
AGAPAY_MQTT_ENABLED=false
AGAPAY_MQTT_HOST=localhost
AGAPAY_MQTT_PORT=1883
AGAPAY_MQTT_TLS=false
AGAPAY_MQTT_USERNAME=
AGAPAY_MQTT_PASSWORD=
AGAPAY_MQTT_CLIENT_ID=agapay-backend-dev
AGAPAY_MQTT_TOPIC=agapay/stations/+/telemetry
