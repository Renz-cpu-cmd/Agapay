      "name": "delivery_generations",
      "sql": "\nCREATE TABLE delivery_generations (\n\tgeneration INTEGER NOT NULL, \n\ttoken VARCHAR(36) NOT NULL, \n\tstate VARCHAR(16) NOT NULL, \n\tkind VARCHAR(16) NOT NULL, \n\treason VARCHAR(500) NOT NULL, \n\tsource_backup_sha256 VARCHAR(64), \n\tdatabase_identity VARCHAR(80), \n\tclaim_seq INTEGER NOT NULL, \n\theld_count INTEGER NOT NULL, \n\tdeclared_by INTEGER, \n\tdeclared_at DATETIME NOT NULL, \n\tactivated_by INTEGER, \n\tactivated_at DATETIME, \n\tPRIMARY KEY (generation), \n\tCONSTRAINT ck_delivery_generation_state CHECK (state IN ('RECOVERING','ACTIVE','SUPERSEDED')), \n\tCONSTRAINT ck_delivery_generation_kind CHECK (kind IN ('initialize','restore','declared')), \n\tCONSTRAINT ck_delivery_generation_claims CHECK (claim_seq >= 0), \n\tUNIQUE (token)\n)\n\n",
      "columns": [
        "generation",
        "token",
        "state",
        "kind",
        "reason",
