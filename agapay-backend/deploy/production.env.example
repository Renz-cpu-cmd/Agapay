# Copy privately to production.env, protect access, and supply real reviewed values.
# Also copy the required identity/SMTP/origin settings from identity.production.env.example.
AGAPAY_ENVIRONMENT=production
AGAPAY_DEPLOYMENT_CONFIRMED=true
AGAPAY_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_SECRET@REPLACE_DATABASE_HOST:5432/agapay?sslmode=verify-full&sslrootcert=/run/agapay-certificates/postgres-root-ca.pem
AGAPAY_LOCAL_ADMIN_SETUP_ENABLED=false
AGAPAY_SEED_DEMO_DATA=false
AGAPAY_PREDICTION_PREVIEW_ENABLED=false
AGAPAY_HYBRID_PROJECTION_ENABLED=false
AGAPAY_STAFF_MFA_REQUIRED=true
AGAPAY_RAIN_GAUGE_STORE_PATH=/var/lib/agapay/rain.db
AGAPAY_RAIN_GAUGE_ENABLED=true
AGAPAY_RAIN_GAUGE_ALLOW_SIMULATOR=false
AGAPAY_RAIN_RAW_RETENTION_DAYS=30
AGAPAY_RAIN_ARCHIVE_DIRECTORY=/var/lib/agapay/rain-archives
AGAPAY_RAIN_ARCHIVE_BATCH=5000
AGAPAY_API_TLS_PROXY_PEER=127.0.0.1
AGAPAY_MQTT_ENABLED=false
AGAPAY_MQTT_EXTERNAL_SUBSCRIBER=false
AGAPAY_MQTT_STATUS_PATH=/var/lib/agapay/ingestion-health.json
# Dedicated ingestion service overrides this to true. Use one owner/client ID.
AGAPAY_MQTT_TLS=true
AGAPAY_MQTT_PORT=8883
AGAPAY_MQTT_HOST=REPLACE_CERTIFICATE_HOSTNAME
AGAPAY_MQTT_CA_FILE=/run/agapay-certificates/mqtt-root-ca.pem
AGAPAY_MQTT_CLIENT_ID=agapay-ingest-REPLACE_UNIQUE_DEPLOYMENT
AGAPAY_MQTT_USERNAME=backend-ingest
AGAPAY_MQTT_PASSWORD=REPLACE_PROTECTED_SECRET
# Unconfigured delivery remains disabled; activate the delivery profile deliberately.
AGAPAY_NOTIFICATION_PROVIDER=disabled
AGAPAY_NOTIFICATION_TTL_SECONDS=300
AGAPAY_NOTIFICATION_RECEIPT_DAYS=7
# Shared read model and workflow diagnostics. Declare only enabled capabilities required.
# Add notifications/models after configuring and starting those services.
AGAPAY_READ_MODEL_CACHE_ENABLED=true
AGAPAY_READ_MODEL_WORKER_ENABLED=true
AGAPAY_READ_MODEL_SECONDS=2
AGAPAY_READ_MODEL_MAX_STATIONS=200
AGAPAY_READ_MODEL_MAX_POINTS=30000
AGAPAY_OPERATIONS_REQUIRED=["monitoring","mqtt","rain","identity_mail"]
AGAPAY_OPERATIONS_PROBE_ENABLED=true
AGAPAY_OPERATIONS_MIN_FREE_BYTES=16777216
AGAPAY_OPERATIONS_QUEUE_AGE_SECONDS=60
AGAPAY_OBSERVABILITY_ENABLED=true
# Generate a private random value of >=32 characters. Put the same value in the
# Prometheus authorization credentials file; never expose it through Next.js.
AGAPAY_OBSERVABILITY_SCRAPE_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_SCRAPE_SECRET
