# Template only. Never use the development defaults for the production service.
AGAPAY_ENVIRONMENT=production
AGAPAY_DEPLOYMENT_CONFIRMED=true
AGAPAY_API_TLS_PROXY_PEER=127.0.0.1
AGAPAY_DATABASE_URL=
AGAPAY_PUBLIC_WEB_ORIGIN=https://your-reviewed-domain.example
AGAPAY_CORS_ORIGINS=["https://your-reviewed-domain.example"]
AGAPAY_LOCAL_ADMIN_SETUP_ENABLED=false
AGAPAY_SEED_DEMO_DATA=false
AGAPAY_PREDICTION_PREVIEW_ENABLED=false
AGAPAY_STAFF_MFA_REQUIRED=true
# Generate and store privately; preserve for encrypted MFA seeds and queued mail.
AGAPAY_IDENTITY_ENCRYPTION_KEY=
AGAPAY_IDENTITY_MAIL_PROVIDER=smtp
AGAPAY_SMTP_HOST=
AGAPAY_SMTP_PORT=587
AGAPAY_SMTP_TLS_MODE=starttls
AGAPAY_SMTP_USERNAME=
AGAPAY_SMTP_PASSWORD=
AGAPAY_SMTP_SENDER=
# The BFF must use the same dedicated proxy key. The edge header must be overwritten by the reverse proxy.
AGAPAY_AUTH_TRUSTED_PROXY_PEERS=["127.0.0.1/32"]
AGAPAY_AUTH_PROXY_KEY=
# Web service only (never NEXT_PUBLIC_*):
# AGAPAY_API_URL=http://127.0.0.1:8000
# AGAPAY_WEB_ORIGIN=https://your-reviewed-domain.example
# AGAPAY_TRUSTED_CLIENT_IP_HEADER=x-agapay-edge-ip

AGAPAY_PUBLIC_API_ORIGIN=https://api.REPLACE_WITH_REVIEWED_DOMAIN
AGAPAY_MQTT_ENABLED=true
AGAPAY_MQTT_HOST=REPLACE_WITH_CERTIFICATE_DNS_NAME
AGAPAY_MQTT_PORT=8883
AGAPAY_MQTT_TLS=true
AGAPAY_MQTT_CLIENT_ID=agapay-backend-REPLACE_WITH_UNIQUE_INSTANCE
AGAPAY_MQTT_USERNAME=backend-ingest
AGAPAY_MQTT_PASSWORD=REPLACE_THROUGH_PROTECTED_SECRET_INJECTION
AGAPAY_MQTT_CA_FILE=/etc/agapay/mqtt-root-ca.pem
