{
  "$defs": {
    "ForecastPoint": {
      "additionalProperties": false,
      "properties": {
        "horizon_minutes": {
          "enum": [
            30,
            60,
            90
          ],
          "title": "Horizon Minutes",
          "type": "integer"
        },
        "target_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target At"
        },
        "water_depth_cm": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Water Depth Cm"
        },
        "lower_depth_cm": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Depth Cm"
        },
        "upper_depth_cm": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Depth Cm"
        }
      },
      "required": [
        "horizon_minutes"
      ],
      "title": "ForecastPoint",
      "type": "object"
    },
    "ForecastUncertainty": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "calibration_event_max_absolute_residual_all_horizons",
          "title": "Method",
          "type": "string"
        },
        "nominal_coverage": {
          "maximum": 0.99,
          "minimum": 0.8,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "withheld_event_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Withheld Event Coverage",
          "type": "number"
        },
        "calibration_events": {
          "minimum": 1,
          "title": "Calibration Events",
          "type": "integer"
        },
        "test_events": {
          "minimum": 1,
          "title": "Test Events",
          "type": "integer"
        },
        "policy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "display_resolution_cm": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Display Resolution Cm",
          "type": "number"
        },
        "notice": {
          "const": "Event-calibrated local-depth interval; coverage can fail under drift",
          "default": "Event-calibrated local-depth interval; coverage can fail under drift",
          "title": "Notice",
          "type": "string"
        }
      },
      "required": [
        "method",
        "nominal_coverage",
        "withheld_event_coverage",
        "calibration_events",
        "test_events",
        "policy_sha256",
        "display_resolution_cm"
      ],
      "title": "ForecastUncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "station_id": {
      "title": "Station Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "not_trained",
        "unavailable",
        "insufficient_data",
        "stale_data",
        "invalid_data",
        "available",
        "service_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "source": {
      "enum": [
        "none",
        "model",
        "simulated"
      ],
      "title": "Source",
      "type": "string"
    },
    "advisory_only": {
      "const": true,
      "default": true,
      "title": "Advisory Only",
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "input_status": {
      "enum": [
        "usable",
        "insufficient_data",
        "stale_data",
        "invalid_data"
      ],
      "title": "Input Status",
      "type": "string"
    },
    "input_window_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Window Start"
    },
    "input_last_recorded_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Last Recorded At"
    },
    "sample_count": {
      "minimum": 0,
      "title": "Sample Count",
      "type": "integer"
    },
    "valid_sample_count": {
      "minimum": 0,
      "title": "Valid Sample Count",
      "type": "integer"
    },
    "timestamp_basis": {
      "enum": [
        "server_received",
        "device_measured",
        "synthetic"
      ],
      "title": "Timestamp Basis",
      "type": "string"
    },
    "rainfall_interval_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rainfall Interval Seconds"
    },
    "preview_allowed": {
      "title": "Preview Allowed",
      "type": "boolean"
    },
    "forecasts": {
      "items": {
        "$ref": "#/$defs/ForecastPoint"
      },
      "title": "Forecasts",
      "type": "array"
    },
    "forecast_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forecast Id"
    },
    "deployment_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deployment Version"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "reference_datum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Datum"
    },
    "model_card_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Card Id"
    },
    "data_cutoff": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Cutoff"
    },
    "measurement_source": {
      "anyOf": [
        {
          "const": "registry_verified_physical_device",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Source"
    },
    "ingress_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingress Identity"
    },
    "registry_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registry Version"
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForecastUncertainty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "station_id",
    "status",
    "reason",
    "source",
    "checked_at",
    "input_status",
    "sample_count",
    "valid_sample_count",
    "timestamp_basis",
    "preview_allowed",
    "forecasts"
  ],
  "title": "PredictionResponse",
  "type": "object"
}
