# Used only by the Next.js server. Do not prefix this with NEXT_PUBLIC_.
AGAPAY_API_URL=http://127.0.0.1:8000
# Set to the exact public web origin when deploying behind a reverse proxy.
# AGAPAY_WEB_ORIGIN=https://agapay.example.com

# Browser-visible Google Maps credentials. Restrict the key to the Maps JavaScript API
# and the deployed website origins in Google Cloud before production use.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
# NEXT_PUBLIC_GOOGLE_MAP_ID=your_vector_map_id
